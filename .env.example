# =============================================================================
# EmorTrades — environment variables
# Copy to `.env` and fill in real values:  cp .env.example .env
# Every value below is a PLACEHOLDER — never commit real secrets.
# =============================================================================

# ── REQUIRED — the app does not boot without these ───────────────────────────

# Prisma database connection string (SQLite absolute file URL).
DATABASE_URL="file:/absolute/path/to/db/custom.db"

# HMAC secret that signs session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET="your-secret-here"

# ── REQUIRED IN PRODUCTION (guarded build refuses to publish without them) ───

# Canonical public origin of the deployment, no trailing slash (e.g. https://app.example.com).
# Used for OAuth redirects, absolute links, and origin pinning.
PUBLIC_ORIGIN="https://your-domain-here"

# ── DEV / SANDBOX ─────────────────────────────────────────────────────────────

# Origin pin for the dev/preview sandbox (dev server + preview deployments).
# Leave unset for a plain local `bun run dev`.
DEV_ORIGIN="https://your-preview-sandbox-origin-here"

# ── OPTIONAL — Google sign-in ─────────────────────────────────────────────────

# OAuth client for "Sign in with Google". When unset, Google sign-in is hidden
# and email/password auth still works.
GOOGLE_CLIENT_ID="your-client-id-here"
GOOGLE_CLIENT_SECRET="your-secret-here"

# ── ADMIN — DB export & backup tooling ───────────────────────────────────────

# Shared token accepted by /api/admin/export (X-Export-Token header) and used by
# `bun run sync:prod`. Required for the guarded production build.
DB_EXPORT_TOKEN="your-secret-here"

# ── ADMIN — Gmail integration (Google-Cloud-Integration project) ─────────────

# Separate OAuth client used by the admin Gmail integration (distinct from the
# sign-in client above).
GOOGLE_INTEGRATION_CLIENT_ID="your-client-id-here"
GOOGLE_INTEGRATION_CLIENT_SECRET="your-secret-here"

# Google service-account key JSON (Drive/Sheets/Calendar foundation) as a single
# string. Keep this value secret — it grants API access to the integration.
GOOGLE_SERVICE_ACCOUNT_JSON="your-json-key-here"

# ── OPTIONAL — email delivery (Resend) ───────────────────────────────────────

# Resend API key for transactional email (verification links, password resets).
RESEND_API_KEY="your-secret-here"

# Sender address for outgoing email. Falls back to a default when unset.
EMAIL_FROM="EmorTrades <noreply@your-domain-here>"

# ── OPTIONAL — bot protection (Cloudflare Turnstile) ─────────────────────────

# When BOTH are set, register/login forms render a Turnstile challenge and the
# server verifies the token. When unset, bot protection is disabled.
TURNSTILE_SITE_KEY="your-site-key-here"
TURNSTILE_SECRET_KEY="your-secret-here"

# ── OPTIONAL — SEO & analytics (public pages only) ───────────────────────────

# Google Search Console verification token; emitted as a meta tag when set.
GOOGLE_SITE_VERIFICATION="your-token-here"

# Google Analytics 4 measurement ID; loaded on public pages only.
GA_MEASUREMENT_ID="your-measurement-id-here"

# ── OPTIONAL — AI provider keys (server-side only) ───────────────────────────

# Any subset may be set; only configured providers appear as selectable.
# OpenAI chat-completions provider.
OPENAI_API_KEY="your-secret-here"
# Anthropic Messages API provider.
ANTHROPIC_API_KEY="your-secret-here"
# OpenRouter aggregator provider (one key, many models).
OPENROUTER_API_KEY="your-secret-here"

# ── OPTIONAL — data import ────────────────────────────────────────────────────

# Override path for the persisted import-templates file.
# Defaults to ./uploads/import-templates.json.
IMPORT_TEMPLATES_PATH="/absolute/path/to/import-templates.json"

# ── OPERATIONS — one-off scripts ──────────────────────────────────────────────

# Target origin for `bun run sync:prod` (pulls a DB export from production).
PROD_ORIGIN="https://your-production-origin-here"

# ── FRAMEWORK (set automatically — do not configure) ──────────────────────────

# Node/Next runtime mode: development | production | test.
# NODE_ENV
