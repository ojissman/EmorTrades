# secrets — the GitHub token lives OUTSIDE the repo (read from
# /home/z/emortrades-backups/.github-token by the autopush script, chmod 600);
# credential/token files are also ignored as belt-and-braces so no `git add`
# can ever leak them into the (private) repository
.zscripts/git-credentials
**/git-credentials
**/.github-token

# env files stay on disk only — never commit secrets
.env

# transient dev/sandbox artifacts
.zscripts/dev.pid

# GIT-1 (2026-10-28): the live journal db now travels with the repo — the owner
# switched to versioned GitHub backups (private repo, rolling 5 dated releases).
# The autopush script checkpoints the WAL before each snapshot; the sidecar
# files stay ignored and the -wal is force-added only if a checkpoint is busy.
db/custom.db-shm
db/custom.db-wal

# ENFORCEMENT (owner-mandated 2026-10-31): local proof of the last verified
# production pull. Written only by scripts/sync-prod-db.ts on full success;
# read by scripts/git-hooks/pre-push. Local truth — a fresh sandbox starts
# without it and stays push-locked until the first real `bun run sync:prod`.
.sync-state
