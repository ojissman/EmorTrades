#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
# ENFORCEMENT PRE-PUSH HOOK — owner-mandated strict rule (2026-10-31)
#
#   "No pull and replacement of the sandbox DB → no task is done."
#   (ENFORCE-3, 2026-11-01: "…and no unprotected .env either.")
#   (ENFORCE-5, 2026-11-01: "…and every worklog entry ends with THE RITUAL
#    — the fixed protocol text itself, repeated verbatim as the last
#    section, before the push happens." Amended same day, RITUAL-AMEND-1:
#    "…and the same entry lands in AGENTS.md too — ritual step 5 — with
#    the block ending that file as well." Amended again same day,
#    RITUAL-AMEND-2 — the owner replaced the whole protocol text with
#    "THE RITUAL — MANDATORY DEVELOPMENT PROTOCOL": the block now sits
#    exactly ONCE at the absolute end of THREE files — worklog.md,
#    AGENTS.md, AND CLAUDE.md — new content is always inserted ABOVE it,
#    nothing is ever appended after it, and it is never duplicated or
#    modified. LOCK 3 became 3a/3b/3c accordingly.)
#
# The Option-2 ritual requires EVERY task cycle to start with
# `bun run sync:prod` (fresh production export → replaces the sandbox DB).
# A task is only "done" when its commit is PUSHED — so this hook makes the
# push itself physically impossible unless a verified production pull
# happened after the last push.
#
# LOCK 1 — ENV-MANIFEST (ENFORCE-3): the live .env must be exactly what the
#   encrypted backup protects. backups/secrets.manifest (plaintext, committed)
#   carries the sha256 of the .env that was encrypted into secrets.enc. Push
#   is refused unless: (a) .env exists, (b) sha256(live .env) == manifest
#   hash, (c) the rotation (secrets.enc + secrets.manifest) is committed.
#   Consequence: ANY key added/changed in .env physically requires rotating
#   the backup (owner passphrase on stdin) and committing it before any task
#   can complete. A missing/truncated .env cannot push either — restore first.
#
# LOCK 2 — SYNC-STATE (ENFORCE-1): see below.
#
# LOCK 3 — THE RITUAL BLOCK (ENFORCE-5; RITUAL-AMEND-1; RITUAL-AMEND-2,
#   owner mandate 2026-11-01 — "THE RITUAL — MANDATORY DEVELOPMENT
#   PROTOCOL"): see below. The push is refused unless THREE COMMITTED
#   files (HEAD, not the working tree — "wrote it but forgot to commit"
#   still refuses) each END with the complete ritual block: worklog.md
#   (LOCK 3a), AGENTS.md (LOCK 3b), CLAUDE.md (LOCK 3c). Per file:
#   the block header appears EXACTLY ONCE, NOTHING is written after the
#   block, the file's last non-blank line is the block's closing sentence,
#   and the body carries the stable marker phrases verbatim.
#
# HOW IT DECIDES:
#   · origin/main tip = the last state that successfully reached GitHub.
#   · .sync-state (written ONLY by sync-prod-db.ts on a fully verified
#     pull+swap) carries lastPullEpoch.
#   · Push is allowed ⇔ lastPullEpoch > commit time of origin/main's tip.
#     i.e. the sandbox DB was refreshed from production AFTER the previous
#     push and BEFORE this one — exactly one pull per task cycle.
#
# SURVIVES EVERYTHING: this file is committed to the repo. A brand-new
# sandbox cloned/restored from GitHub re-arms it automatically via the
# `prepare` script in package.json (bun install → install-git-hooks.sh).
# A fresh sandbox has no .sync-state → the first push is REFUSED until the
# first real `bun run sync:prod` runs. That is by design.
#
# IF sync:prod CANNOT PULL (production down, token drift after a sandbox
# restart): DO NOT bypass silently. Inform the owner explicitly, get their
# instruction, document it in worklog.md, and only then (owner-authorized)
# use `git push --no-verify`. Silent bypass is a protocol violation.
# ─────────────────────────────────────────────────────────────────────────────
set -u

TOP="$(git rev-parse --show-toplevel 2>/dev/null)" || TOP="$(pwd)"

# Only enforce pushes of main (task completions). Branch pushes and ref
# deletions are out of scope.
ENFORCE=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" != "0000000000000000000000000000000000000000" ] || continue
  ENFORCE=1
done
[ "$ENFORCE" = "1" ] || exit 0

# ── LOCK 1 · ENV-MANIFEST (ENFORCE-3) ────────────────────────────────────
refuse_env() {
  cat >&2 <<EOF

──────────────────────────────────────────────────────────────────
  ENV-MANIFEST LOCK — PUSH REFUSED  (ENFORCE-3, owner-mandated)

  $1

  REQUIRED before this push can succeed:
    · restore/rotate the secrets backup (owner passphrase on stdin):
        echo "<OWNER_PASSPHRASE>" | bun scripts/secrets-backup.ts restore|backup
    · commit the rotation: git add backups/secrets.enc backups/secrets.manifest
    · then re-run this push

  One passphrase for life — the system never asks the owner to change it.
──────────────────────────────────────────────────────────────────

EOF
  exit 1
}

ENV_FILE="$TOP/.env"
MANIFEST="$TOP/backups/secrets.manifest"
[ -f "$ENV_FILE" ] || refuse_env "Live .env is MISSING — the task is not done on a broken environment. Restore it from the encrypted backup first."
[ -f "$MANIFEST" ] || refuse_env "backups/secrets.manifest is missing — the secrets-coverage lock cannot verify. Restore it (git checkout -- backups/) or rotate a fresh backup."

file_sha() {
  sha256sum "$1" 2>/dev/null | cut -d' ' -f1 || shasum -a 256 "$1" 2>/dev/null | cut -d' ' -f1
}
LIVE_ENV_HASH="$(file_sha "$ENV_FILE")"
MANIFEST_HASH="$(grep -m1 '^envSha256=' "$MANIFEST" | cut -d= -f2)"
[ -n "$LIVE_ENV_HASH" ] || refuse_env "Could not hash the live .env (sha256sum unavailable?) — refusing rather than guessing."
[ "$LIVE_ENV_HASH" = "$MANIFEST_HASH" ] || refuse_env "Live .env DIFFERS from the protected backup (a key was added/changed since the last rotation). The change is unprotected — rotate first."

# The rotation must also be committed — otherwise a wipe would clone the OLD
# protection and silently lose the new keys (the exact gap ENFORCE-3 closes).
if [ -n "$(git status --porcelain -- backups/secrets.enc backups/secrets.manifest 2>/dev/null)" ]; then
  refuse_env "A secrets rotation is present but NOT committed — commit backups/secrets.enc + backups/secrets.manifest so the GitHub time machine carries it."
fi
echo "[enforcement] env verified (live .env fully protected, rotation committed)."

# ── LOCK 2 · SYNC-STATE (ENFORCE-1) ─────────────────────────────────

# Bootstrap: no origin/main ref locally yet (first ever push) — nothing to
# compare against. Every push after the first is enforced.
TIP="$(git rev-parse --verify -q origin/main 2>/dev/null)" || exit 0
[ -n "$TIP" ] || exit 0
TIP_CT="$(git show -s --format=%ct "$TIP" 2>/dev/null)" || TIP_CT=0

LAST_PULL=0
if [ -f "$TOP/.sync-state" ]; then
  LAST_PULL="$(grep -m1 -oE 'lastPullEpoch=[0-9]+' "$TOP/.sync-state" | cut -d= -f2)"
  LAST_PULL="${LAST_PULL:-0}"
fi

if [ "$LAST_PULL" -le "$TIP_CT" ]; then
  cat >&2 <<EOF

════════════════════════════════════════════════════════════════
  ENFORCEMENT RULE — PUSH REFUSED  (owner-mandated, non-negotiable)

  "No pull and replacement of the sandbox DB, no task is done."

  The sandbox DB has NOT been refreshed from production since the last
  push (last pull epoch: ${LAST_PULL}; last pushed commit: ${TIP_CT}).

  REQUIRED before this push can succeed:
    1. bun run sync:prod     ← pull + replace + verify (writes .sync-state)
    2. then re-run this push

  If sync:prod FAILS (production unreachable, token drift):
    · DO NOT bypass silently — that is a protocol violation.
    · Inform the owner explicitly and follow their instruction.
    · Document the failure in worklog.md.
    · Only an explicit owner authorization permits \`git push --no-verify\`.
════════════════════════════════════════════════════════════════

EOF
  exit 1
fi

echo "[enforcement] pull verified (epoch ${LAST_PULL} > pushed-tip ${TIP_CT}) — push allowed."

# ── LOCK 3 · THE RITUAL BLOCK (ENFORCE-5; RITUAL-AMEND-2, 2026-11-01) ─────
# Owner mandate: "THE RITUAL — MANDATORY DEVELOPMENT PROTOCOL" — the block
# sits exactly ONCE at the absolute end of worklog.md, AGENTS.md, and
# CLAUDE.md. New content is inserted ABOVE it; nothing is ever appended
# after it; it is never duplicated, deleted, shortened, rewritten, or
# modified. The push is refused unless every one of the three COMMITTED
# files (HEAD) satisfies all four checks: exactly once, final content,
# closing sentence, verbatim markers.
refuse_ritual() {
  cat >&2 <<EOF

──────────────────────────────────────────────────────────────────
  THE RITUAL BLOCK LOCK — PUSH REFUSED  (owner-mandated)

  $1

  "THE RITUAL — MANDATORY DEVELOPMENT PROTOCOL" sits exactly ONCE at
  the absolute end of worklog.md, AGENTS.md, and CLAUDE.md. New task
  entries and documentation are inserted ABOVE the block — never after
  it; the block is never duplicated or modified. Fix the file(s), COMMIT,
  then re-run this push. The complete canonical block (verbatim):

    ### THE RITUAL — MANDATORY DEVELOPMENT PROTOCOL

    This protocol is permanent and must remain intact at the absolute end of
    WORKLOG.md, AGENTS.md, and CLAUDE.md.

    **DAILY RITUAL**

    (Once per day, before anything.)

    The owner says "Pull GitHub latest" and provides the GitHub token +
    repository → run `bun run day:start` → the gate must print
    CLEARED TO WORK and this result must be reported to the owner before
    the day's first task.

    No gate, no work.

    **TASK RITUAL**

    (Every task, exact order, no exceptions.)

    1. PULL FIRST: Run `bun run sync:prod`. A fresh production export must
       replace the sandbox DB before any code is changed.
    2. IMPLEMENT: Implement on the freshly pulled production data.
    3. VERIFY: Verify end-to-end in the app. The preview must demonstrate
       that the implementation works.
    4. WORKLOG.md: Append the new task entry
       ABOVE the existing ritual block. Verify that the ritual block
       remains the final content.
    5. AGENTS.md: Update task documentation, agent roles, functions, or
       instructions as necessary. Place all new content
       ABOVE the existing ritual block. Verify that the ritual block
       remains the final content.
    6. CLAUDE.md: Update applicable instructions and task documentation.
       Place all new content ABOVE the existing ritual block. Verify that
       the ritual block remains the final content.
    7. COMMIT + PUSH: Commit and run `git push`. This must be the final
       development operation.

    **PERMANENT RITUAL PRESERVATION RULE**

    These three files must ALWAYS end with the complete ritual block:

    - WORKLOG.md
    - AGENTS.md
    - CLAUDE.md

    The following rules are mandatory:

    1. The ritual block must appear exactly once in each file.
    2. New task entries and documentation must always be inserted ABOVE the
       existing ritual block.
    3. Never append new content after the ritual block.
    4. Never duplicate the ritual block.
    5. Never delete, shorten, rewrite, or modify the ritual block.
    6. If the ritual block is missing, restore the complete original block
       at the bottom.
    7. If the ritual block is not at the bottom, move it there without
       losing existing content.
    8. Before committing and pushing, verify that all three files end with
       the complete ritual block.
    9. New agents, agent functions, capabilities, responsibilities, and
       operating instructions must be documented ABOVE the ritual block in
       AGENTS.md.

    **ABSOLUTE COMPLETION RULE**

    No production pull and replacement of the sandbox DB → NO task is done.

    No end-to-end verification → NO task is done.

    No documentation updates and ritual-position verification → NO task is
    done.

    No commit and push → NO task is done.

    Always follow this strict mandatory development workflow, including both
    levels of control: DAILY RITUAL and TASK RITUAL.

    The ritual is the permanent Command, Instruction, and reminder that this protocol exists.
──────────────────────────────────────────────────────────────────

EOF
  exit 1
}

# The block's stable markers — checked on the body of the block in each
# file. Paraphrase (or any pre-amendment text) fails by design.
ritual_markers_missing() { # $1 = block body text; echoes what is missing
  printf '%s\n' "$1" | grep -q 'bun run day:start' || { echo "the DAILY RITUAL gate command (bun run day:start)"; return; }
  printf '%s\n' "$1" | grep -q 'CLEARED TO WORK' || { echo "the daily gate requirement (CLEARED TO WORK)"; return; }
  printf '%s\n' "$1" | grep -q 'bun run sync:prod' || { echo "the TASK RITUAL pull command (bun run sync:prod)"; return; }
  printf '%s\n' "$1" | grep -q 'ABOVE the existing ritual block' || { echo "the insertion rule (new content ABOVE the existing ritual block)"; return; }
  printf '%s\n' "$1" | grep -q 'PERMANENT RITUAL PRESERVATION RULE' || { echo "the PERMANENT RITUAL PRESERVATION RULE section"; return; }
  printf '%s\n' "$1" | grep -q 'exactly once in each file' || { echo "the exactly-once rule (the ritual block must appear exactly once in each file)"; return; }
  printf '%s\n' "$1" | grep -q 'WORKLOG.md, AGENTS.md, and CLAUDE.md' || { echo "the three-file coverage (WORKLOG.md, AGENTS.md, and CLAUDE.md)"; return; }
  printf '%s\n' "$1" | grep -q 'ABSOLUTE COMPLETION RULE' || { echo "the ABSOLUTE COMPLETION RULE section"; return; }
  printf '%s\n' "$1" | grep -q 'No production pull and replacement of the sandbox DB → NO task is done.' || { echo "the strict-rule sentence (No production pull and replacement of the sandbox DB → NO task is done.)"; return; }
  printf '%s\n' "$1" | grep -q 'The ritual is the permanent Command, Instruction, and reminder that this protocol exists.' || { echo "the closing sentence (The ritual is the permanent Command, Instruction, and reminder that this protocol exists.)"; return; }
  return 0
}

check_ritual_file() { # $1 = file label, $2 = full blob; refuses on any violation
  LABEL="$1"
  BLOB="$2"
  # 1 · EXACTLY ONCE — never duplicate the block.
  COUNT="$(printf '%s\n' "$BLOB" | grep -c '^### THE RITUAL')"
  [ "$COUNT" -eq 1 ] || refuse_ritual "[$LABEL] The ritual block must appear EXACTLY ONCE — found $COUNT occurrence(s) of the block header. Never duplicate the block; exactly one block lives at the bottom of the file."
  # 1b · THE NEW HEADER — RITUAL-AMEND-2's block, not a pre-amendment one.
  printf '%s\n' "$BLOB" | grep -q '^### THE RITUAL — MANDATORY DEVELOPMENT PROTOCOL$' || refuse_ritual "[$LABEL] The block header is not RITUAL-AMEND-2's 'THE RITUAL — MANDATORY DEVELOPMENT PROTOCOL' — a pre-amendment block was found instead. Restore the complete original block at the bottom."
  # 2 · FINAL CONTENT — nothing may be written after the block.
  RITUAL_AT="$(printf '%s\n' "$BLOB" | grep -n '^### THE RITUAL' | tail -1 | cut -d: -f1)"
  AFTER="$(printf '%s\n' "$BLOB" | tail -n +"$((RITUAL_AT + 1))")"
  printf '%s\n' "$AFTER" | grep -q '^#' && refuse_ritual "[$LABEL] Content was written AFTER the ritual block — the block must remain the file's FINAL content. Move the new content ABOVE the block (PERMANENT RITUAL PRESERVATION RULE)."
  # 3 · CLOSING SENTENCE — the file ends with the block's last line.
  LAST_LINE="$(printf '%s\n' "$BLOB" | sed '/^[[:space:]]*$/d' | tail -n 1)"
  [ "$LAST_LINE" = "The ritual is the permanent Command, Instruction, and reminder that this protocol exists." ] || refuse_ritual "[$LABEL] The file does not end with the ritual block's closing sentence — the COMPLETE block must be the file's final content (restore the original block at the bottom if it was truncated)."
  # 4 · VERBATIM MARKERS — paraphrase fails by design.
  MISSING="$(ritual_markers_missing "$AFTER")"
  [ -z "$MISSING" ] || refuse_ritual "[$LABEL] The ritual block is missing $MISSING."
}

# LOCK 3a — worklog.md (ritual step 4)
WL_BLOB="$(git show HEAD:worklog.md 2>/dev/null)" || refuse_ritual "worklog.md is not in the commit being pushed (HEAD) — a push without the worklog update is a push without the task record."
check_ritual_file "worklog.md" "$WL_BLOB"

# LOCK 3b — AGENTS.md (ritual step 5)
AG_BLOB="$(git show HEAD:AGENTS.md 2>/dev/null)" || refuse_ritual "AGENTS.md is not in the commit being pushed (HEAD) — the runbook (ending with the ritual block) must travel with every push."
check_ritual_file "AGENTS.md" "$AG_BLOB"

# LOCK 3c — CLAUDE.md (ritual step 6, RITUAL-AMEND-2)
CL_BLOB="$(git show HEAD:CLAUDE.md 2>/dev/null)" || refuse_ritual "CLAUDE.md is not in the commit being pushed (HEAD) — RITUAL-AMEND-2 requires worklog.md, AGENTS.md, AND CLAUDE.md to end with the ritual block."
check_ritual_file "CLAUDE.md" "$CL_BLOB"

echo "[enforcement] THE RITUAL present — the complete block ends worklog.md AND AGENTS.md AND CLAUDE.md (exactly once, final content, verbatim markers)."

exit 0
